# Local directory for data, plugins, and modules
.terraform/

# Process logs and crash reports
crash.log
crash.*.log

# Local execution plan outputs
*.tfplan

# All terraform.tfstate files (can contain plaintext secrets)
*.tfstate
*.tfstate.*

# Exclude all variable files as they often contain secrets
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you explicitly wish to track (optional example)
# !override.tf

# CLI configuration files
.terraformrc
terraform.rc
